{
  "realm": "local-ai",
  "displayName": "Local AI Lab",
  "enabled": true,
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": false,
  "sslRequired": "external",
  "bruteForceProtected": true,
  "roles": {
    "realm": [
      {"name": "inference.user", "description": "Call text, vision and embedding APIs"},
      {"name": "inference.operator", "description": "Operate the inference lab"}
    ]
  },
  "clients": [
    {
      "clientId": "local-ai-gateway",
      "name": "Local AI Gateway",
      "enabled": true,
      "protocol": "openid-connect",
      "bearerOnly": true
    },
    {
      "clientId": "local-ai-cli",
      "name": "Local AI CLI",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "oauth2DeviceAuthorizationGrantEnabled": true,
      "redirectUris": ["http://127.0.0.1/*"],
      "webOrigins": ["http://127.0.0.1"],
      "protocolMappers": [
        {
          "name": "gateway-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "local-ai-gateway",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "groups": [
    {
      "name": "employees",
      "realmRoles": ["inference.user"]
    },
    {
      "name": "operators",
      "realmRoles": ["inference.user", "inference.operator"]
    }
  ]
}
