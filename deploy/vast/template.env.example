# Non-secret defaults for one NVIDIA GPU with at least 32 GB VRAM.
# Add HF_TOKEN only as an instance/account secret if Hugging Face requires it.

LLM_MODEL=Qwen/Qwen3-VL-8B-Instruct
LLM_REVISION=0c351dd01ed87e9c1b53cbc748cba10e6187ff3b
LLM_SERVED_NAME=local-vision-language
LLM_DTYPE=bfloat16
LLM_MAX_MODEL_LEN=8192
LLM_GPU_MEMORY_UTILIZATION=0.72
LLM_MAX_NUM_SEQS=4
LLM_MAX_IMAGES_PER_PROMPT=2
LLM_TENSOR_PARALLEL_SIZE=1
VLLM_ALLOWED_MEDIA_DOMAIN=qianwen-res.oss-cn-beijing.aliyuncs.com

EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_REVISION=5617a9f61b028005a4858fdac845db406aefb181
EMBEDDING_SERVED_NAME=BAAI/bge-m3
EMBEDDING_GPU_MEMORY_UTILIZATION=0.15

MODEL_STARTUP_TIMEOUT_SECONDS=1800
GATEWAY_REQUEST_TIMEOUT_SECONDS=120
GATEWAY_MAX_BODY_BYTES=10485760
GATEWAY_MAX_CONCURRENCY=8
GATEWAY_QUEUE_TIMEOUT_SECONDS=5
